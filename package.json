{
  "name": "@amatiscorp/pagincord",
  "version": "2.2.0",
  "description": "Smart, fully configurable embed pagination for Discord.js v14+. Lazy pages, progress bars, search, themes, and EN/ES/PT/FR/DE/IT locales.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "discord",
    "discordjs",
    "pagination",
    "paginator",
    "embeds",
    "embed",
    "discord-pagination",
    "buttons",
    "select-menu",
    "components",
    "slash-commands",
    "discord-v14",
    "discord.js",
    "typescript",
    "i18n",
    "amatiscorp"
  ],
  "author": "Amatis Corp <dymidless@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amatiscorp/pagincord.git"
  },
  "homepage": "https://github.com/amatiscorp/pagincord#readme",
  "bugs": {
    "url": "https://github.com/amatiscorp/pagincord/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "discord.js": "^14.14.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.11.0"
  }
}
